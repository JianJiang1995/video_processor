# ============================================================
# Video Analyzer - 环境变量配置
# cp .env.example .env，填入实际值后运行 docker compose up -d
# ============================================================

# Gemini API Key（用于 VLM 总结）
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI API Key（可选）
OPENAI_API_KEY=

# MySQL 密码
MYSQL_ROOT_PASSWORD=surgr1pass
MYSQL_PASSWORD=apppass

# ModelScope Token（首次启动自动下载私有模型 lonsirky/SurgR1）
# 获取：https://modelscope.cn/my/myaccesstoken
MODELSCOPE_API_TOKEN=ms-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ModelScope 模型 ID（默认即可）
MODELSCOPE_MODEL_ID=lonsirky/SurgR1

# GPU 分配（0=第一块卡，all=全部）
SURGR1_GPU=0
