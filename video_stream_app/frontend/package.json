{
  "name": "video-stream-analyzer",
  "version": "1.0.0",
  "description": "Professional video analysis tool for medical video processing",
  "author": {
    "name": "Surg-R1 Team",
    "email": "support@surgr1.local"
  },
  "homepage": "https://github.com/videoanalyzer/video-stream-analyzer",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "preelectron:dev": "fuser -k 5174/tcp 2>/dev/null || true",
    "electron:dev": "concurrently -k \"vite\" \"wait-on -t 30000 tcp:5174 && electron . --dev\"",
    "electron:preview": "vite build && electron .",
    "electron:build": "vite build && electron-builder",
    "electron:build:linux": "vite build && electron-builder --linux",
    "electron:build:win": "vite build && electron-builder --win"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "axios": "^1.6.0",
    "pinia": "^2.1.0",
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.surgr1.app",
    "productName": "Surg-R1手术助手",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Medical"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
