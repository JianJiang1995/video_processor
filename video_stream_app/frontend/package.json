{
  "name": "video-stream-analyzer",
  "version": "1.0.0",
  "description": "Professional video analysis tool for medical video processing with embedded AI services",
  "author": {
    "name": "Surg-R1 Team",
    "email": "support@surgr1.local"
  },
  "homepage": "https://github.com/videoanalyzer/video-stream-analyzer",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview",
    "preelectron:dev": "fuser -k 5133/tcp 2>/dev/null || true",
    "electron:dev": "concurrently -k \"vite\" \"wait-on -t 30000 tcp:5133 && electron . --dev --no-sandbox\"",
    "preelectron:local": "fuser -k 5133/tcp 2>/dev/null || true",
    "electron:local": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on -t 30000 tcp:5133 && VITE_DEV_SERVER_URL=http://127.0.0.1:5133 electron . --dev --no-sandbox\"",
    "electron:preview": "vite build && electron .",
    "electron:build": "vite build && electron-builder",
    "electron:build:linux": "vite build && electron-builder --linux",
    "electron:build:win": "vite build && electron-builder --win",
    "build:standalone": "cd .. && bash build_standalone.sh --linux",
    "build:standalone:win": "cd .. && bash build_standalone.sh --win",
    "build:standalone:all": "cd .. && bash build_standalone.sh --all",
    "build:standalone:backend-only": "cd .. && bash build_standalone.sh --linux --services=backend"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dompurify": "3.4.12",
    "electron-store": "^8.1.0",
    "marked": "18.0.6",
    "pinia": "^2.1.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^8.2.2",
    "electron": "^36.0.0",
    "electron-builder": "^25.1.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.surgr1.app",
    "productName": "Surg-R1手术助手",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Medical"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
